# Safe to commit — contains no real secrets, only placeholders/defaults.

POSTGRES_DB=scalexai
POSTGRES_USER=scalexai
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://scalexai:change-me@postgres:5432/scalexai

TOOL_A_URL=http://tool_a:8000/run
TOOL_B_URL=http://tool_b:8000/run
TOOL_C_URL=http://tool_c:8000/run
